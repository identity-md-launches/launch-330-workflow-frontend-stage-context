{
  "name": "ember-buyback-burn-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static single-page frontend for the Ember (EMBR) BuybackBurnHook on Sepolia",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build && node scripts/finalize-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:manifest": "node scripts/finalize-manifest.mjs --check"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
